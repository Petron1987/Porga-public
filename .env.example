# Copy to .env locally. NEVER commit .env. Offline mode needs no credentials.
PORGA_MODE=mock
PORGA_DATA_DIR=.porga
OPENAI_AGENTS_DISABLE_TRACING=1
# Online mode requires ALL of these. Use a model available in your account.
OPENAI_API_KEY=
PORGA_MODEL=
# User-maintained prices, USD per million tokens. No guessed price defaults.
PORGA_INPUT_USD_PER_MILLION=
PORGA_OUTPUT_USD_PER_MILLION=
PORGA_MAX_USD=0.50
PORGA_DAILY_MAX_USD=2.00
PORGA_MAX_CALLS=6
PORGA_MAX_TOKENS=80000
PORGA_MAX_OUTPUT_TOKENS=1600
PORGA_MAX_INPUT_BYTES=16000
PORGA_TIMEOUT_SECONDS=45
